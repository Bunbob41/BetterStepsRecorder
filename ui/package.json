{
  "name": "bettersteps-ui",
  "version": "0.2.2",
  "description": "Record what you do on screen and turn it into a guide",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "build:capture": "dotnet publish ../capture -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -o ../capture/bin/packed",
    "dist": "npm run stamp && npm run build:capture && electron-builder && node ../scripts/name-build.js",
    "dist:release": "npm run stamp && npm run build:capture && electron-builder",
    "dist:dir": "npm run stamp && npm run build:capture && electron-builder --dir",
    "stamp": "node ../scripts/stamp-build.js",
    "test": "node ../scripts/run-tests.js",
    "test:window": "electron ../tests/window_test.js",
    "test:composite": "electron ../tests/composite_test.js",
    "test:photos": "electron ../tests/photos_image_test.js",
    "test:diagrams": "electron ../tests/diagrams_test.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "mermaid": "^11.17.2"
  },
  "productName": "Steps Recorder",
  "author": "Bunbob41",
  "build": {
    "appId": "com.bunbob41.stepsrecorder",
    "productName": "Steps Recorder",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../capture/bin/packed/bettersteps-capture.exe",
        "to": "capture/bettersteps-capture.exe"
      },
      {
        "from": "../templates",
        "to": "templates"
      },
      {
        "from": "build-info.json",
        "to": "build-info.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "StepsRecorder-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Steps Recorder"
    }
  },
  "dependencies": {
    "docx-templates": "^4.15.0",
    "jszip": "^3.10.1"
  }
}
