<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>logictests</AssemblyName>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the engine's pure logic directly; no hooks, no input, no COM. -->
    <Compile Include="../../capture/Keys.cs" />
    <Compile Include="../../capture/UiaNaming.cs" />
    <Compile Include="../../capture/Scope.cs" />
    <Compile Include="../../capture/TypingState.cs" />
    <Compile Include="../../capture/CaptureOptions.cs" />
    <Compile Include="../../capture/Win32.cs" />
    <Compile Include="../../capture/ScreenCapture.cs" />
    <Compile Include="../../capture/StepDescriber.cs" />
    <!-- Window queries and process information: no hooks, no COM, so it
         belongs here by the same rule as the rest. -->
    <Compile Include="../../capture/WindowResolver.cs" />
    <Compile Include="../../capture/Protocol.cs" />
  </ItemGroup>
</Project>
